{
  "settings.wallpaper.change": [
    { "action": "open", "target": "Settings", "delay": 500 },
    { "action": "maximize", "target": "Settings", "delay": 700 },
    { "action": "move", "target": "settings_sidebar_wallpaper", "delay": 1000 },
    { "action": "click", "target": "settings_sidebar_wallpaper", "delay": 1200 },
    { "action": "move", "target": "wallpaper_input", "delay": 1500 },
    { "action": "click", "target": "wallpaper_input", "delay": 1700 },
    {
      "action": "type",
      "target": "wallpaper_input",
      "params": { "text": "{{prompt}}", "options": { "delay": 70, "humanLike": true } },
      "delay": 300
    },
    { "action": "move", "target": "wallpaper_search_button", "delay": 500 },
    { "action": "click", "target": "wallpaper_search_button", "delay": 700 },
    { "action": "wait", "target": "wallpaper_results_container", "params": { "timeout": 8000, "condition": "imagesLoaded" } },
    { "action": "move", "target": "{{wallpaperResultId}}", "delay": 1000 },
    { "action": "click", "target": "{{wallpaperResultId}}", "delay": 1200 },
    { "action": "close", "target": "Settings", "delay": 500 },
    {
      "action": "speak",
      "params": { "text": "Wallpaper changed successfully, {{username}}!", "options": { "rate": 0.9 } }
    }
  ],

  "settings.wallpaper.search": [
    { "action": "open", "target": "Settings", "delay": 500 },
    { "action": "maximize", "target": "Settings", "delay": 700 },
    { "action": "move", "target": "settings_sidebar_wallpaper", "delay": 1000 },
    { "action": "click", "target": "settings_sidebar_wallpaper", "delay": 1200 },
    { "action": "move", "target": "wallpaper_input", "delay": 1500 },
    { "action": "click", "target": "wallpaper_input", "delay": 1700 },
    {
      "action": "type",
      "target": "wallpaper_input",
      "params": { "text": "{{query}}", "options": { "delay": 70 } }
    },
    { "action": "click", "target": "wallpaper_search_button", "delay": 500 }
  ],

  "settings.wallpaper.selectResult": [
    { "action": "wait", "target": "wallpaper_results_container", "params": { "timeout": 8000, "condition": "imagesLoaded" } },
    { "action": "move", "target": "{{wallpaperResultId}}", "delay": 1000 },
    { "action": "click", "target": "{{wallpaperResultId}}", "delay": 1000 }
  ],

