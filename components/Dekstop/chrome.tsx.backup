'use client'

import React, { useEffect, useState, useRef } from "react";

interface BrowserProps {
  isAppOpen: boolean;
  searchQuery?: string; // Dynamic search from voice/terminal/GLM
  directUrl?: string; // Direct navigation URL
  windowConfig?: {
    position?: "right" | "left" | "center";
    width?: string; // e.g., "30%", "40%"
    height?: string; // e.g., "full", "80vh"
    zIndex?: number; // Stacking order
  };
  onLoad?: () => void;
  onNavigate?: (url: string) => void;
  onError?: (error: string) => void;
}

function Browser({ 
  isAppOpen, 
  searchQuery, 
  directUrl,
  windowConfig,
  onLoad,
  onNavigate,
  onError
}: BrowserProps) {
  const [currentUrl, setCurrentUrl] = useState("https://www.google.com/webhp?igu=1");
  const [isLoading, setIsLoading] = useState(false);
  const [searchInput, setSearchInput] = useState("");
  const [navigationHistory, setNavigationHistory] = useState<string[]>([]);
  const [historyIndex, setHistoryIndex] = useState(-1);
  const iframeRef = useRef<HTMLIFrameElement>(null);

  // Default window configuration (right side, 30% width, full height, highest z-index)
  const config = {
    position: windowConfig?.position || "right",
    width: windowConfig?.width || "30%",
    height: windowConfig?.height || "full",
    zIndex: windowConfig?.zIndex || 9999
  };

  // Helper function to add URL to history
  const addToHistory = (url: string) => {
    setNavigationHistory(prev => [...prev.slice(0, historyIndex + 1), url]);
    setHistoryIndex(prev => prev + 1);
  };

  // Update URL when searchQuery or directUrl changes (GLM integration)
  useEffect(() => {
    if (directUrl) {
      setCurrentUrl(directUrl);
      addToHistory(directUrl);
      setIsLoading(true);
      console.log(`🌐 GLM Navigation: ${directUrl}`);
    } else if (searchQuery) {
      const encoded = encodeURIComponent(searchQuery);
      const googleUrl = `https://www.google.com/search?q=${encoded}`;
      setCurrentUrl(googleUrl);
      setSearchInput(searchQuery);
      addToHistory(googleUrl);
      setIsLoading(true);
      console.log(`🔍 GLM Search: ${searchQuery}`);
    } else {
      setCurrentUrl("https://www.google.com/webhp?igu=1");
    }
  }, [searchQuery, directUrl]);

  // Calculate position styles based on config
  const getPositionStyles = () => {
    const baseStyles: React.CSSProperties = {
      position: "absolute",
      zIndex: config.zIndex,
      height: config.height === "full" ? "100vh" : config.height,
      width: config.width,
      transition: "all 0.3s ease-in-out"
    };

    switch (config.position) {
      case "right":
        return {
          ...baseStyles,
          right: 0,
          top: 0
        };
      case "left":
        return {
          ...baseStyles,
          left: 0,
          top: 0
        };
      case "center":
        return {
          ...baseStyles,
          left: "50%",
          top: 0,
          transform: "translateX(-50%)"
        };
      default:
        return baseStyles;
    }
  };

  // Navigation handlers for GLM automation
  const handleBack = () => {
    if (historyIndex > 0) {
      setHistoryIndex(prev => prev - 1);
      setCurrentUrl(navigationHistory[historyIndex - 1]);
      setIsLoading(true);
    }
  };

  const handleForward = () => {
    if (historyIndex < navigationHistory.length - 1) {
      setHistoryIndex(prev => prev + 1);
      setCurrentUrl(navigationHistory[historyIndex + 1]);
      setIsLoading(true);
    }
  };

  const handleRefresh = () => {
    setIsLoading(true);
    if (iframeRef.current) {
      iframeRef.current.src = currentUrl;
    }
  };

  const handleManualSearch = (e: React.FormEvent) => {
    e.preventDefault();
    if (searchInput.trim()) {
      const encoded = encodeURIComponent(searchInput.trim());
      const googleUrl = `https://www.google.com/search?q=${encoded}`;
      setCurrentUrl(googleUrl);
      addToHistory(googleUrl);
      setIsLoading(true);
      onNavigate?.(googleUrl);
    }
  };

  const handleUrlChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setCurrentUrl(e.target.value);
  };

  const handleUrlSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    let url = currentUrl;
    if (!url.startsWith('http://') && !url.startsWith('https://')) {
      url = 'https://' + url;
    }
    setCurrentUrl(url);
    addToHistory(url);
    setIsLoading(true);
    onNavigate?.(url);
  };

  const handleIframeLoad = () => {
    setIsLoading(false);
    onLoad?.();
    
    // Try to communicate with GLM browser automation
    try {
      if (iframeRef.current?.contentWindow) {
        iframeRef.current.contentWindow.postMessage({
          type: 'GLM_BROWSER_READY',
          url: currentUrl,
          searchQuery: searchQuery
        }, '*');
      }
    } catch (e) {
      console.log('GLM postMessage:', e);
    }
  };

  const handleError = () => {
    setIsLoading(false);
    onError?.("Failed to load page");
  };

  if (!isAppOpen) return null;

  return (
    <div style={getPositionStyles()}>
      <div className="bg-[hsl(240,5.9%,10%)] h-full w-full overflow-hidden">
        {/* Browser Header - Matches Desktop Dark Theme Exactly */}
        <div className="border-b border-gray-700/30">
          {/* Traffic lights - Exactly like desktop windows */}
          <div className="h-10 flex items-center justify-between px-3 bg-[hsl(240,5.9%,10%)]">
            <div className="flex items-center gap-2">
              <button 
                className="w-3 h-3 rounded-full bg-red-500 hover:bg-red-600 cursor-pointer flex items-center justify-center group transition-colors"
                onClick={() => {
                  if (typeof window !== 'undefined') {
                    window.dispatchEvent(new CustomEvent('close-chrome-browser'));
                  }
                }}
                title="Close"
              >
                <span className="text-red-900 text-[10px] opacity-0 group-hover:opacity-100">×</span>
              </button>
              <div className="w-3 h-3 rounded-full bg-yellow-500 opacity-50"></div>
              <div className="w-3 h-3 rounded-full bg-green-500 opacity-50"></div>
              
              <span className="text-xs text-gray-400 ml-2 font-normal">
                Chrome{searchQuery && <span className="text-gray-500 ml-1">- {searchQuery}</span>}
              </span>
            </div>
            {isLoading && (
              <span className="text-xs text-blue-400 animate-pulse">Searching...</span>
            )}
          </div>

          {/* Search Bar - PROMINENT LIKE REAL GOOGLE */}
          <div className="px-6 py-4 bg-black/80">
            <form onSubmit={handleManualSearch} className="w-full">
              <div className="relative">
                {/* Search Icon */}
                <div className="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500">
                  <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                
                {/* Search Input */}
                <input
                  type="text"
                  value={searchInput}
                  onChange={(e) => setSearchInput(e.target.value)}
                  className="w-full bg-black text-white text-base px-12 py-3.5 rounded-full border border-gray-700 hover:border-gray-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all"
                  placeholder="Search the web with Google..."
                  autoFocus
                />
                
                {/* Clear Button */}
                {searchInput && (
                  <button
                    type="button"
                    onClick={() => setSearchInput('')} 
                    className="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-300"
                  >
                    ✕
                  </button>
                )}
              </div>
              
              {/* Search Buttons */}
              <div className="flex gap-3 justify-center mt-4">
                <button
                  type="submit"
                  className="px-6 py-2 bg-gray-800 hover:bg-gray-700 text-gray-200 text-sm rounded hover:ring-1 hover:ring-gray-600 transition-all"
                >
                  Google Search
                </button>
                <button
                  type="button"
                  onClick={() => {
                    if (searchInput.trim()) {
                      const encoded = encodeURIComponent(searchInput.trim());
                      setCurrentUrl(`https://www.google.com/search?q=${encoded}`);
                      addToHistory(`https://www.google.com/search?q=${encoded}`);
                      setIsLoading(true);
                    }
                  }}
                  className="px-6 py-2 bg-gray-800 hover:bg-gray-700 text-gray-200 text-sm rounded hover:ring-1 hover:ring-gray-600 transition-all"
                >
                  I'm Feeling Lucky
                </button>
              </div>
            </form>
          </div>

          {/* Navigation Bar - COMPACT */}
          <div className="h-10 flex items-center gap-2 px-4 bg-black/70 border-b border-gray-800">
            {/* Back/Forward/Refresh */}
            <div className="flex gap-1">
              <button 
                onClick={handleBack}
                disabled={historyIndex <= 0}
                className="p-1.5 text-gray-400 hover:text-white hover:bg-gray-800 rounded disabled:opacity-30 disabled:cursor-not-allowed transition-all"
                title="Back"
              >
                ←
              </button>
              <button 
                onClick={handleForward}
                disabled={historyIndex >= navigationHistory.length - 1}
                className="p-1.5 text-gray-400 hover:text-white hover:bg-gray-800 rounded disabled:opacity-30 disabled:cursor-not-allowed transition-all"
                title="Forward"
              >
                →
              </button>
              <button 
                onClick={handleRefresh}
                className="p-1.5 text-gray-400 hover:text-white hover:bg-gray-800 rounded transition-all"
                title="Refresh"
              >
                ⟳
              </button>
            </div>

            {/* URL Bar */}
            <form onSubmit={handleUrlSubmit} className="flex-1">
              <input
                type="text"
                value={currentUrl}
                onChange={handleUrlChange}
                className="w-full bg-black text-white text-xs px-3 py-1.5 rounded border border-gray-700 hover:border-gray-600 focus:border-blue-500 focus:outline-none transition-all"
                placeholder="https://..."
              />
            </form>
          </div>
        </div>
        
        {/* Content Area */}
        <div className="h-[calc(100vh-112px)] w-full relative bg-white">
          {isLoading && (
            <div className="absolute inset-0 bg-gray-900/80 flex items-center justify-center z-10">
              <div className="text-center">
                <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto mb-4"></div>
                <p className="text-gray-400 text-sm">Loading {searchQuery ? `"${searchQuery}"` : 'page'}...</p>
              </div>
            </div>
          )}
          
          <iframe 
            ref={iframeRef}
            src={currentUrl} 
            className="w-full h-full border-0" 
            id="chrome-browser" 
            title="Chrome Browser - GLM Integrated"
            sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-top-navigation"
            onLoad={handleIframeLoad}
            onError={handleError}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          />
        </div>
      </div>
    </div>
  );
}

export default Browser;